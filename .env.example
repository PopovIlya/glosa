# Anthropic API key (platform.claude.com → API Keys). Without it Glosa calls the `claude` CLI you are logged in to.
ANTHROPIC_API_KEY=
# Optional: API model (default claude-opus-5-5; claude-haiku-5-5 answers faster)
CLAUDE_MODEL=
# Optional: model alias for the claude CLI (default opus; sonnet or haiku answer faster)
CLAUDE_CLI_MODEL=
# Optional: where the decks live (defaults below)
GLOSA_VOCAB_ES=~/Claude/spanish/vocab.json
GLOSA_VOCAB_EN=~/Claude/english/vocab.json
